{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "portfolio-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "vars": {
    "NODE_ENV": "production"
  },
  
  "durable_objects": {
  "bindings": [
      {
        "name": "SESSION_BUCKETS",
        "class_name": "SessionBucket"
      }
    ]
  },

  "exports": {
    "SessionBucket": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "ratelimits": [
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "7643294",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
